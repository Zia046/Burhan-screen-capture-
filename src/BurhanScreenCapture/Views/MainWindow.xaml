<Window x:Class="BurhanScreenCapture.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Burhan Screen Capture Pro" Width="1120" Height="720" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}"
        FontFamily="{StaticResource UiFont}" Icon="/BurhanScreenCapture;component/Assets/app.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,12,18">
                    <Image Source="/BurhanScreenCapture;component/Assets/logo.png" Width="36" Height="36"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Burhan Screen" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Capture Pro" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Accent}"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12" Padding="12" CornerRadius="8" Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="EditionText" Text="Free Edition" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="EditionSub" Text="Upgrade for Pro tools" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,8"/>
                        <Button x:Name="SidebarUpgrade" Content="Upgrade to Pro" Style="{StaticResource GoldButton}" Click="OnUpgradeClick"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Nav">
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="Home" Checked="OnNav" IsChecked="True">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Width="28"/><TextBlock Text="Dashboard"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavCapture" Style="{StaticResource NavButton}" Tag="Capture" Checked="OnNav">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE722;" Width="28"/><TextBlock Text="Capture Screenshot"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavRecorder" Style="{StaticResource NavButton}" Tag="Recorder" Checked="OnNav">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE714;" Width="28"/><TextBlock Text="Screen Recorder"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavEditor" Style="{StaticResource NavButton}" Tag="Editor" Checked="OnNav">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Width="28"/><TextBlock Text="Image Editor"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="History" Checked="OnNav">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Width="28"/><TextBlock Text="Screenshot History"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavButton}" Tag="Tools" Checked="OnNav">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" Width="28"/><TextBlock Text="Quick Tools"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="Settings" Checked="OnNav">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Width="28"/><TextBlock Text="Settings"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavUpgrade" Style="{StaticResource NavButton}" Tag="Upgrade" Checked="OnNav">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE734;" Width="28" Foreground="{DynamicResource ProGold}"/><TextBlock Text="Upgrade to Pro"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" Tag="About" Checked="OnNav">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Width="28"/><TextBlock Text="About Burhan Nexus"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False"/>
    </Grid>
</Window>
