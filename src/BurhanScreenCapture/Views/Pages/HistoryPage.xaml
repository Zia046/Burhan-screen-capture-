<UserControl x:Class="BurhanScreenCapture.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BurhanScreenCapture.Controls">
    <DockPanel Margin="32,28,20,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,12,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="240" Margin="0,0,8,0">
                    <TextBox x:Name="Search" TextChanged="OnSearch" ToolTip="Search by file name, date or recognised text (Pro)"/>
                    <TextBlock x:Name="SearchHint" Text="Search history…" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                </Grid>
                <Button Content="Remove missing" Margin="0,0,8,0" Click="OnRemoveMissing" ToolTip="Remove entries whose files were moved or deleted"/>
                <Button Content="Clear history" Click="OnClear"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Screenshot History" Style="{StaticResource H1}"/>
                <TextBlock x:Name="LimitText" Style="{StaticResource Muted}"/>
            </StackPanel>
        </DockPanel>
        <Grid>
            <TextBlock x:Name="Empty" Text="No screenshots yet. Press Print Screen to capture." Style="{StaticResource Muted}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,12,10">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="170" Height="100" CornerRadius="6" Background="{DynamicResource SurfaceAltBg}" Margin="0,0,16,0"
                                        Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="OnThumb" ToolTip="Open in editor">
                                    <Image Source="{Binding ThumbPath, Converter={StaticResource PathToImage}}" Stretch="Uniform"/>
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open image" Tag="{Binding}" Click="OnOpen"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy" Tag="{Binding}" Click="OnCopy"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit" Tag="{Binding}" Click="OnEdit"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Open containing folder" Tag="{Binding}" Click="OnFolder"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete" Tag="{Binding}" Click="OnDelete" Foreground="{DynamicResource Danger}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0">
                                        <Run Text="{Binding DateText, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Format, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
