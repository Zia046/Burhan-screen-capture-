<UserControl x:Class="BurhanScreenCapture.Views.Pages.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Image Editor" Style="{StaticResource H1}"/>
            <TextBlock Text="Crop, resize, rotate and annotate screenshots or any image. Your original files are never changed until you save." Style="{StaticResource Muted}" Margin="0,0,0,20"/>
            <Border Style="{StaticResource Card}" Padding="40" BorderThickness="2" Margin="0,0,0,16">
                <Border.BorderBrush>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Rectangle StrokeDashArray="4 3" Stroke="#8899AA" StrokeThickness="1" Width="100" Height="100"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.BorderBrush>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="40" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="Drop an image here" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="PNG, JPG, BMP, GIF or TIFF" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Open image…" Style="{StaticResource PrimaryButton}" Click="OnOpen" Margin="0,0,8,0"/>
                        <Button Content="Paste from clipboard" Click="OnPaste" Margin="0,0,8,0"/>
                        <Button Content="Capture area &amp; edit" Click="OnCapture" Margin="0,0,8,0"/>
                        <Button Content="Open last screenshot" Click="OnLast"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Editor tools" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Free: crop, resize, rotate, flip, arrows, lines, rectangles, circles, text, colors, undo/redo, save and copy.&#x0a;Pro: blur, pixelate, magnifier, spotlight, highlighter, numbered steps, filled shapes, watermark, templates, OCR and BMP/TIFF/GIF export."/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Text="Shortcuts: V select • A arrow • L line • R rectangle • E ellipse • T text • C crop • Ctrl+Z / Ctrl+Y • Ctrl+S save • Ctrl+C copy • Ctrl+mouse wheel zoom"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
