<UserControl x:Class="BurhanScreenCapture.Views.Pages.UpgradePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock x:Name="PageTitle" Text="Upgrade to Pro" Style="{StaticResource H1}"/>
            <TextBlock Text="Two simple choices. No subscriptions, no renewals." Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,20"/>

            <!-- Activated status (Lifetime Pro) -->
            <Border x:Name="ActiveCard" Style="{StaticResource Card}" BorderBrush="{DynamicResource Success}" BorderThickness="2" Margin="0,0,0,18" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="LICENSE STATUS: LIFETIME PRO ACTIVATED" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Success}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="License Type" Style="{StaticResource Muted}" Margin="0,3"/>
                            <TextBlock Grid.Column="1" Text="Lifetime" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Text="License" Style="{StaticResource Muted}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Permanently Activated — never expires" Style="{StaticResource Label}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Text="Activation Date" Style="{StaticResource Muted}" Margin="0,3"/>
                            <TextBlock x:Name="ActDate" Grid.Row="2" Grid.Column="1" Style="{StaticResource Label}" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Text="License ID" Style="{StaticResource Muted}" Margin="0,3"/>
                            <TextBox x:Name="ActId" Grid.Row="3" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" Width="260" HorizontalAlignment="Left" Margin="0,3"/>
                            <TextBlock Grid.Row="4" Text="Device" Style="{StaticResource Muted}" Margin="0,3"/>
                            <TextBlock x:Name="ActDevice" Grid.Row="4" Grid.Column="1" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,3"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="Deactivate / transfer" Click="OnDeactivate"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Problem with a stored license -->
            <Border x:Name="ProblemCard" Style="{StaticResource Card}" BorderBrush="{DynamicResource Danger}" Margin="0,0,0,18" Visibility="Collapsed">
                <TextBlock x:Name="ProblemText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"/>
            </Border>

            <!-- The two options -->
            <Grid x:Name="Options" Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="24">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="FREE EDITION" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="Free" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
                            <TextBlock Text="Free Forever • no payment • no key • never expires" Style="{StaticResource Muted}" Margin="0,2,0,16"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource Success}" Margin="0,2,10,0"/><TextBlock Text="Free Forever" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource Success}" Margin="0,2,10,0"/><TextBlock Text="Basic Screenshot Tools" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource Success}" Margin="0,2,10,0"/><TextBlock Text="Screen Recording (no watermark, no time limit)" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource Success}" Margin="0,2,10,0"/><TextBlock Text="System Audio Recording" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource Success}" Margin="0,2,10,0"/><TextBlock Text="Microphone Recording" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource Success}" Margin="0,2,10,0"/><TextBlock Text="Basic Image Editing" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource Success}" Margin="0,2,10,0"/><TextBlock Text="PNG &amp; JPG export, history (latest 20)" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                        </StackPanel>
                        <Button x:Name="FreeBtn" DockPanel.Dock="Bottom" Content="Continue with Free" Margin="0,20,0,0" Padding="14,10" Click="OnContinueFree" VerticalAlignment="Bottom"/>
                        <Border/>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24" BorderBrush="{DynamicResource ProGold}" BorderThickness="2">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LIFETIME PRO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ProGold}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource ProGold}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0">
                                    <TextBlock Text="ONE-TIME PURCHASE" FontSize="10" FontWeight="Bold" Foreground="#1B1405"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Pay once" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
                            <TextBlock Text="Lifetime access • no monthly or yearly payments" Style="{StaticResource Muted}" Margin="0,2,0,16"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource ProGold}" Margin="0,2,10,0"/><TextBlock Text="One-Time Purchase, Lifetime Access" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource ProGold}" Margin="0,2,10,0"/><TextBlock Text="Scrolling Screenshot" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource ProGold}" Margin="0,2,10,0"/><TextBlock Text="GIF Recording" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource ProGold}" Margin="0,2,10,0"/><TextBlock Text="Advanced Blur and Pixelate" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource ProGold}" Margin="0,2,10,0"/><TextBlock Text="OCR — extract text from images" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource ProGold}" Margin="0,2,10,0"/><TextBlock Text="Advanced Image Editing" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource ProGold}" Margin="0,2,10,0"/><TextBlock Text="Batch Image Processing" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource ProGold}" Margin="0,2,10,0"/><TextBlock Text="Unlimited Screenshot History + search" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource ProGold}" Margin="0,2,10,0"/><TextBlock Text="Advanced Export Options" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Foreground="{DynamicResource ProGold}" Margin="0,2,10,0"/><TextBlock Text="All other Pro features" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="300"/></StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="ProButtons" DockPanel.Dock="Bottom" Margin="0,20,0,0" VerticalAlignment="Bottom">
                            <Button Content="Purchase Lifetime License" Style="{StaticResource GoldButton}" Padding="14,10" Click="OnPurchase"/>
                            <Button Content="Enter License Key" Margin="0,8,0,0" Padding="14,10" Click="OnEnterKey"/>
                        </StackPanel>
                        <Border/>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Copy" VerticalAlignment="Center" Click="OnCopyDevice"/>
                    <StackPanel>
                        <TextBlock Text="This computer" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DeviceText" Style="{StaticResource Muted}" FontFamily="Consolas"/>
                        <TextBlock Text="Send this Device ID when you purchase, so your license key is issued for this computer." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Free vs Lifetime Pro" Style="{StaticResource H2}"/>
                    <Grid x:Name="Compare"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
