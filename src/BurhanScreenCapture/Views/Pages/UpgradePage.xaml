<UserControl x:Class="BurhanScreenCapture.Views.Pages.UpgradePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="960" HorizontalAlignment="Left">
            <TextBlock Text="Upgrade to Pro" Style="{StaticResource H1}"/>
            <TextBlock Text="Everything in Free stays free forever. Pro adds advanced tools for professionals." Style="{StaticResource Muted}" Margin="0,0,0,20"/>

            <!-- Status -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="License status" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="StatusTitle" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,2"/>
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Device ID:" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                            <TextBox x:Name="DeviceId" IsReadOnly="True" Width="190" FontFamily="Consolas"/>
                            <Button Content="Copy" Margin="8,0,0,0" Click="OnCopyDevice"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="TrialBtn" Content="Start 7-day free trial" Style="{StaticResource GoldButton}" Click="OnTrial" Margin="0,0,0,8"/>
                        <Button x:Name="DeactivateBtn" Content="Deactivate / transfer" Click="OnDeactivate"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Activate -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Activate Pro" Style="{StaticResource H2}"/>
                    <TextBlock Text="Enter the license key from your purchase email, or import the license file you received." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="KeyBox" Width="330" FontFamily="Consolas" ToolTip="BSCP-XXXXX-XXXXX-XXXXX-XXXXX"/>
                        <Button x:Name="ActivateBtn" Content="Activate" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnActivate"/>
                        <Button Content="Import license file…" Margin="8,0,0,0" Click="OnImport"/>
                    </StackPanel>
                    <TextBlock x:Name="ActivateMsg" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Plans -->
            <TextBlock Text="Plans" Style="{StaticResource H2}" Margin="0,4,0,10"/>
            <UniformGrid x:Name="PlanCards" Columns="3" Margin="-6,0,-6,8"/>
            <Button Content="Buy Pro" Style="{StaticResource GoldButton}" HorizontalAlignment="Left" Padding="22,9" Click="OnBuy" Margin="0,4,0,20"/>

            <!-- Comparison -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Free vs Pro" Style="{StaticResource H2}"/>
                    <Grid x:Name="Compare"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
