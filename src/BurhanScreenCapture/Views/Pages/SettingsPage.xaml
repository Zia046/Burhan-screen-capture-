<UserControl x:Class="BurhanScreenCapture.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BurhanScreenCapture.Controls">
    <UserControl.Resources>
        <Style TargetType="Grid" x:Key="Row"><Setter Property="Margin" Value="0,5"/></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Text="Changes are saved automatically." Style="{StaticResource Muted}" Margin="0,0,0,20"/>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource H2}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Theme" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="200" HorizontalAlignment="Left" SelectionChanged="OnChanged">
                            <ComboBoxItem Content="Use Windows setting"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Language" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="LangBox" Grid.Column="1" Width="200" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Screenshots -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Screenshots" Style="{StaticResource H2}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Default format" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ShotFormat" Grid.Column="1" Width="200" HorizontalAlignment="Left" SelectionChanged="OnChanged">
                            <ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPG"/><ComboBoxItem Content="BMP (Pro)"/><ComboBoxItem Content="TIFF (Pro)"/><ComboBoxItem Content="GIF (Pro)"/>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="JPG quality" Style="{StaticResource Label}"/><c:ProBadge/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Slider x:Name="JpgQuality" Width="200" Minimum="30" Maximum="100" VerticalAlignment="Center" LostMouseCapture="OnQuality" KeyUp="OnQuality"/>
                            <TextBlock Text="{Binding Value, ElementName=JpgQuality, StringFormat={}{0:0}}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Save location" Style="{StaticResource Label}"/>
                        <DockPanel Grid.Column="1">
                            <Button DockPanel.Dock="Right" Content="Change…" Margin="8,0,0,0" Click="OnShotFolder"/>
                            <TextBox x:Name="ShotFolder" IsReadOnly="True"/>
                        </DockPanel>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="File name" Style="{StaticResource Label}" ToolTip="Use {date} and {time}"/>
                        <TextBox x:Name="NamePattern" Grid.Column="1" LostFocus="OnChanged" ToolTip="Use {date} and {time}"/>
                    </Grid>
                    <CheckBox x:Name="AutoSave" Style="{StaticResource Switch}" Content="Save screenshots automatically" Margin="0,6" Click="OnChanged"/>
                    <CheckBox x:Name="Clip" Style="{StaticResource Switch}" Content="Copy screenshots to clipboard" Margin="0,6" Click="OnChanged"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="After capture" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="AfterBox" Grid.Column="1" Width="200" HorizontalAlignment="Left" SelectionChanged="OnChanged">
                            <ComboBoxItem Content="Show preview"/><ComboBoxItem Content="Open in editor"/><ComboBoxItem Content="Just save"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Recording -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Recording" Style="{StaticResource H2}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Default format" Style="{StaticResource Label}"/>
                        <ComboBox Grid.Column="1" Width="200" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="MP4 (H.264 + AAC)"/>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Save location" Style="{StaticResource Label}"/>
                        <DockPanel Grid.Column="1">
                            <Button DockPanel.Dock="Right" Content="Change…" Margin="8,0,0,0" Click="OnRecFolder"/>
                            <TextBox x:Name="RecFolder" IsReadOnly="True"/>
                        </DockPanel>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Default frame rate" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="FpsBox" Grid.Column="1" Width="200" HorizontalAlignment="Left" SelectionChanged="OnChanged">
                            <ComboBoxItem Content="15 fps" Tag="15"/><ComboBoxItem Content="24 fps" Tag="24"/><ComboBoxItem Content="30 fps" Tag="30"/><ComboBoxItem Content="60 fps" Tag="60"/>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Recording quality" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="QualityBox" Grid.Column="1" Width="200" HorizontalAlignment="Left" SelectionChanged="OnChanged">
                            <ComboBoxItem Content="Low"/><ComboBoxItem Content="Standard"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Ultra"/>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Microphone" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="MicBox" Grid.Column="1" Width="320" HorizontalAlignment="Left" SelectionChanged="OnChanged"/>
                    </Grid>
                    <CheckBox x:Name="SysAudio" Style="{StaticResource Switch}" Content="Record system audio by default" Margin="0,6" Click="OnChanged"/>
                    <CheckBox x:Name="MicDefault" Style="{StaticResource Switch}" Content="Record microphone by default" Margin="0,6" Click="OnChanged"/>
                </StackPanel>
            </Border>

            <!-- Shortcuts -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Restore defaults" Click="OnResetHotkeys"/>
                        <TextBlock Text="Keyboard shortcuts" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <TextBlock Text="Click a box and press the new key combination. Backspace clears it." Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                    <StackPanel x:Name="HotkeyList"/>
                    <TextBlock x:Name="HotkeyStatus" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Startup & notifications -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Startup &amp; notifications" Style="{StaticResource H2}"/>
                    <CheckBox x:Name="StartWin" Style="{StaticResource Switch}" Content="Start with Windows" Margin="0,6" Click="OnChanged"/>
                    <CheckBox x:Name="StartMin" Style="{StaticResource Switch}" Content="Start minimized to the notification area" Margin="0,6" Click="OnChanged"/>
                    <CheckBox x:Name="ToTray" Style="{StaticResource Switch}" Content="Closing the window keeps the app running in the notification area" Margin="0,6" Click="OnChanged"/>
                    <CheckBox x:Name="Toolbar" Style="{StaticResource Switch}" Content="Show quick toolbar at startup" Margin="0,6" Click="OnChanged"/>
                    <CheckBox x:Name="Notify" Style="{StaticResource Switch}" Content="Show notifications" Margin="0,6" Click="OnChanged"/>
                </StackPanel>
            </Border>

            <!-- History -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="History" Style="{StaticResource H2}"/>
                    <CheckBox x:Name="HistoryOn" Style="{StaticResource Switch}" Content="Keep screenshot history" Margin="0,6" Click="OnChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="HistoryInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Clear history" Click="OnClearHistory"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Watermark -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Watermark" Style="{StaticResource H2}" Margin="0"/><c:ProBadge/></StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Watermark text" Style="{StaticResource Label}"/>
                        <TextBox x:Name="WmText" Grid.Column="1" LostFocus="OnChanged"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="Opacity" Style="{StaticResource Label}"/>
                        <Slider x:Name="WmOpacity" Grid.Column="1" Width="200" HorizontalAlignment="Left" Minimum="0.15" Maximum="1" LostMouseCapture="OnChanged"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- License -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Manage license" Click="OnLicense" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="License" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="LicenseInfo" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="Open log folder" Margin="0,0,8,0" Click="OnLogs"/>
                <Button Content="Reset all settings" Click="OnResetAll"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
