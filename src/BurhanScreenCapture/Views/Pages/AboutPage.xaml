<UserControl x:Class="BurhanScreenCapture.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="820" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="28" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/BurhanScreenCapture;component/Assets/logo.png" Width="72" Height="72"/>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Burhan Screen Capture Pro" Style="{StaticResource H1}"/>
                            <TextBlock Text="Capture. Create. Communicate." Foreground="{DynamicResource Accent}" FontSize="14"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,20,0,0" LineHeight="22"
                               Text="Burhan Screen Capture Pro is a powerful yet lightweight Windows application developed by Burhan Nexus. It provides professional screenshot capture, screen recording, audio recording, and image editing tools in one simple application."/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Developer" Style="{StaticResource Muted}" Margin="0,4"/>
                    <TextBlock Grid.Column="1" Text="Burhan Nexus" Style="{StaticResource Label}" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Text="Website" Style="{StaticResource Muted}" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4"><Hyperlink x:Name="WebLink" Click="OnWeb"><Run x:Name="WebText"/></Hyperlink></TextBlock>
                    <TextBlock Grid.Row="2" Text="Support" Style="{StaticResource Muted}" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4"><Hyperlink Click="OnMail"><Run x:Name="MailText"/></Hyperlink></TextBlock>
                    <TextBlock Grid.Row="3" Text="Edition" Style="{StaticResource Muted}" Margin="0,4"/>
                    <TextBlock x:Name="EditionText" Grid.Row="3" Grid.Column="1" Style="{StaticResource Label}" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Text="Copyright" Style="{StaticResource Muted}" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="© 2026 Burhan Nexus. All rights reserved." Style="{StaticResource Label}" Margin="0,4"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Third-party components" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="ScreenRecorderLib (MIT) — Media Foundation screen and audio recording.&#x0a;NAudio (MIT) — Windows audio device enumeration and level meters.&#x0a;Windows OCR (Windows.Media.Ocr) — built into Windows 10/11."/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Open log folder" Click="OnLogs" Margin="0,0,8,0"/>
                        <Button Content="Open data folder" Click="OnData"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
