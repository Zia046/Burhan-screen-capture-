<UserControl x:Class="BurhanScreenCapture.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,18,28">
            <TextBlock x:Name="Greeting" Text="Welcome back" Style="{StaticResource H1}"/>
            <TextBlock Text="Capture. Create. Communicate." Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,22"/>

            <!-- Quick capture bar -->
            <Border Style="{StaticResource Card}" Margin="0,0,14,22">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Quick capture" Style="{StaticResource H2}" Margin="0"/>
                        <TextBlock x:Name="HotkeyHint" Text="Print Screen: select area" Style="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Margin="4" Click="OnArea" ToolTip="Drag to select an area (Print Screen)">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A8;" Margin="0,0,8,0" Foreground="White"/><TextBlock Text="Area"/></StackPanel>
                        </Button>
                        <Button Margin="4" Click="OnFull" ToolTip="Capture the screen under the mouse (Ctrl + Print Screen)">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE740;" Margin="0,0,8,0"/><TextBlock Text="Full Screen"/></StackPanel>
                        </Button>
                        <Button Margin="4" Click="OnWindow" ToolTip="Capture the active window (Alt + Print Screen)">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE737;" Margin="0,0,8,0"/><TextBlock Text="Window"/></StackPanel>
                        </Button>
                        <Button Margin="4" Click="OnRecord" ToolTip="Start a screen recording (Ctrl + Shift + R)">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="{DynamicResource Danger}" Margin="0,0,8,0"/><TextBlock Text="Record"/></StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <WrapPanel>
                <Button Style="{StaticResource TileButton}" Tag="Capture" Click="OnTile" ToolTip="Area, window, full screen, delay">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#1463E6" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" Foreground="White" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Capture Screenshot" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,2" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Area, window, full screen, delay" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Tag="Recorder" Click="OnTile" ToolTip="Video with system audio and mic">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#E5484D" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE714;" Foreground="White" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Screen Recorder" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,2" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Video with system audio and mic" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Tag="Editor" Click="OnTile" ToolTip="Crop, annotate, highlight">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#8B5CF6" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Foreground="White" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Image Editor" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,2" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Crop, annotate, highlight" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Tag="History" Click="OnTile" ToolTip="Your recent captures">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#0EA5A4" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Foreground="White" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Screenshot History" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,2" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Your recent captures" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Tag="Tools" Click="OnTile" ToolTip="OCR, batch, templates">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#F97316" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" Foreground="White" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Quick Tools" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,2" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="OCR, batch, templates" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Tag="Settings" Click="OnTile" ToolTip="Folders, formats, shortcuts">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#64748B" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="White" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,2" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Folders, formats, shortcuts" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Tag="Upgrade" Click="OnTile" ToolTip="Unlock advanced tools">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#F5A623" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" Foreground="White" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Upgrade to Pro" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,2" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Unlock advanced tools" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Tag="About" Click="OnTile" ToolTip="Version and support">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#334155" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="White" FontSize="18"/>
                        </Border>
                        <TextBlock Text="About Burhan Nexus" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,2" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Version and support" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <TextBlock Text="Recent screenshots" Style="{StaticResource H2}" Margin="0,14,0,10"/>
            <TextBlock x:Name="NoRecent" Text="Your screenshots will appear here." Style="{StaticResource Muted}"/>
            <ItemsControl x:Name="Recent">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource BaseButton}" Padding="6" Margin="0,0,10,10" Tag="{Binding}" Click="OnRecent"
                                ToolTip="{Binding FileName}" Background="{DynamicResource SurfaceBg}">
                            <StackPanel Width="160">
                                <Image Source="{Binding ThumbPath, Converter={StaticResource PathToImage}}" Height="96" Stretch="Uniform"/>
                                <TextBlock Text="{Binding DateText}" FontSize="11" Margin="2,6,0,0" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
