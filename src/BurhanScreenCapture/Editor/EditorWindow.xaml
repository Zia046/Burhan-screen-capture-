<Window x:Class="BurhanScreenCapture.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Editor — Burhan Screen Capture Pro" Width="1180" Height="760" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}" FontFamily="{StaticResource UiFont}"
        Icon="/BurhanScreenCapture;component/Assets/app.ico" AllowDrop="True" UseLayoutRounding="True">
    <DockPanel>
        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy image (Ctrl+C)" Click="OnCopy"/>
                    <Button Margin="6,0,0,0" Content="Save As…" Click="OnSaveAs"/>
                    <Button Margin="6,0,0,0" Style="{StaticResource PrimaryButton}" Content="Save" ToolTip="Ctrl+S" Click="OnSave"/>
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Open image (Ctrl+O)" Click="OnOpen"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE77F;" ToolTip="Paste image (Ctrl+V)" Click="OnPaste"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE722;" ToolTip="New capture" Click="OnNewCapture"/>
                    <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource BorderBrushSoft}"/>
                    <Button x:Name="UndoBtn" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Click="OnUndo"/>
                    <Button x:Name="RedoBtn" Style="{StaticResource IconButton}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" Click="OnRedo"/>
                    <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource BorderBrushSoft}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE7AD;" ToolTip="Rotate right" Click="OnRotateRight"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE7AD;" ToolTip="Rotate left" Click="OnRotateLeft" RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform><ScaleTransform ScaleX="-1"/></Button.RenderTransform>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8AB;" ToolTip="Flip horizontally" Click="OnFlip"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE744;" ToolTip="Resize image" Click="OnResize"/>
                    <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource BorderBrushSoft}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE71E;" ToolTip="Zoom to fit" Click="OnZoomFit"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="Actual size (100%)" Click="OnZoom100"/>
                    <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource BorderBrushSoft}"/>
                    <Button Padding="10,6" Click="OnOcr" ToolTip="Extract text from this image (Pro)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8D2;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Text (OCR)"/></StackPanel>
                    </Button>
                    <Button Padding="10,6" Margin="6,0,0,0" Click="OnTemplate" ToolTip="Beautiful background template (Pro)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE771;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Template"/></StackPanel>
                    </Button>
                    <Button Padding="10,6" Margin="6,0,0,0" Click="OnWatermark" ToolTip="Add your watermark (Pro)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C6;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Watermark"/></StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- Left tools -->
        <Border DockPanel.Dock="Left" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <RadioButton x:Name="TSelect" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xE8B0;" ToolTip="Select and move (V). Delete removes." Checked="OnTool" Tag="Select"/>
                    <RadioButton x:Name="TArrow" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xE72A;" ToolTip="Arrow (A)" Checked="OnTool" Tag="Arrow"/>
                    <RadioButton x:Name="TLine" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xE738;" ToolTip="Line (L)" Checked="OnTool" Tag="Line"/>
                    <RadioButton x:Name="TRect" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xE739;" ToolTip="Rectangle (R)" Checked="OnTool" Tag="Rect"/>
                    <RadioButton x:Name="TEllipse" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xEA3A;" ToolTip="Circle / ellipse (E)" Checked="OnTool" Tag="Ellipse"/>
                    <RadioButton x:Name="TText" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xE8D2;" ToolTip="Text (T)" Checked="OnTool" Tag="Text"/>
                    <RadioButton x:Name="TCrop" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xE7A8;" ToolTip="Crop (C)" Checked="OnTool" Tag="Crop"/>
                    <Rectangle Height="1" Margin="4,6" Fill="{DynamicResource BorderBrushSoft}"/>
                    <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ProGold}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <RadioButton x:Name="THighlight" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xE7E6;" ToolTip="Highlighter (Pro)" Checked="OnTool" Tag="Highlight"/>
                    <RadioButton x:Name="TFilled" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xE91F;" ToolTip="Filled rectangle (Pro)" Checked="OnTool" Tag="Filled"/>
                    <RadioButton x:Name="TStep" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xF146;" ToolTip="Numbered steps (Pro)" Checked="OnTool" Tag="Step"/>
                    <RadioButton x:Name="TBlur" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xE727;" ToolTip="Blur area (Pro)" Checked="OnTool" Tag="Blur"/>
                    <RadioButton x:Name="TPixelate" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xF0E2;" ToolTip="Pixelate area (Pro)" Checked="OnTool" Tag="Pixelate"/>
                    <RadioButton x:Name="TMagnifier" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xE71E;" ToolTip="Magnifier (Pro)" Checked="OnTool" Tag="Magnifier"/>
                    <RadioButton x:Name="TSpotlight" Style="{StaticResource ToolButton}" GroupName="tools" Content="&#xE781;" ToolTip="Spotlight (Pro)" Checked="OnTool" Tag="Spotlight"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Properties -->
        <Border DockPanel.Dock="Right" Width="190" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1,0,0,0" Padding="14">
            <StackPanel>
                <TextBlock Text="Color" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <WrapPanel x:Name="Swatches"/>
                <TextBlock Text="Thickness" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="20" Value="4" IsSnapToTickEnabled="True" TickFrequency="1"/>
                <TextBlock Text="Text size" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <Slider x:Name="FontSlider" Minimum="10" Maximum="96" Value="24" IsSnapToTickEnabled="True" TickFrequency="2"/>
                <CheckBox x:Name="TextBgBox" Content="Text background" Margin="0,8,0,0" IsChecked="True"/>
                <TextBlock Text="Blur / pixel strength" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <Slider x:Name="StrengthSlider" Minimum="2" Maximum="40" Value="12"/>
                <TextBlock x:Name="ToolHelp" Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>

        <!-- Canvas -->
        <Grid Background="{DynamicResource WindowBg}">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" ClipToBounds="True">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                    </Grid.LayoutTransform>
                    <Image x:Name="BaseImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Canvas x:Name="Layer" Background="Transparent" ClipToBounds="True"
                            MouseLeftButtonDown="OnDown" MouseMove="OnMove" MouseLeftButtonUp="OnUp"/>
                </Grid>
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="48" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="Open, paste or drop an image to start editing" Style="{StaticResource Muted}" FontSize="14" Margin="0,12,0,14" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Open image…" Style="{StaticResource PrimaryButton}" Click="OnOpen" Margin="0,0,8,0"/>
                    <Button Content="Paste" Click="OnPaste" Margin="0,0,8,0"/>
                    <Button Content="Capture area" Click="OnNewCapture"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
